DISCORD_TOKEN=
GUILD_ID=
STATS_CHANNEL_ID=
CATEGORY_ID=
# 任意
# リアルタイム共有（就寝・起床をその場で投稿）のチャンネル。未設定ならリアルタイム共有は選べない
REPORT_CHANNEL_ID=
DATABASE_PATH=data/sleep.db
# 昼寝(3時間未満)を睡眠時間の合計に含めるか
INCLUDE_NAPS_IN_TOTAL=false
# 記録がなくても /mystats で空の枠（画像）を出す（実験フェーズ用。本番では false）
PREVIEW_EMPTY_STATS=true
# おやすみ中の入眠時刻を暗号化して一時保存する鍵（README の作り方参照）。未設定だと再起動で消える
PENDING_KEY=
# グループ（ロール限定チャンネル）。「ロールID:チャンネルID」をカンマ区切り。ロールを持つ人はそのチャンネルで時刻まで自動共有
GROUPS=
